# Copy to .env for local ingestion/dev, and add the same vars in the Vercel
# dashboard (Project → Settings → Environment Variables) for production.
# .env is gitignored — never commit real keys.

# Supabase — Project Settings → API
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key   # secret, server-side only

# OpenAI — platform.openai.com/api-keys
OPENAI_API_KEY=sk-...

# Optional: override the chat model (default: gpt-4o)
# CHAT_MODEL=gpt-4o
