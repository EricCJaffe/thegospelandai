# Copy to .env for local ingestion/dev, and add the same vars in the Vercel
# dashboard (Project → Settings → Environment Variables) for production.
# .env is gitignored — never commit real keys.

# Supabase — Project Settings → API
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key   # secret, server-side only

# OpenAI — platform.openai.com/api-keys
OPENAI_API_KEY=sk-...

# Optional: override the chat model (default: gpt-4o)
# CHAT_MODEL=gpt-4o

# Admin UI password (required for /admin.html + /api/admin/* to work).
# Until set, admin endpoints return 503. Add the same value in Vercel.
# ADMIN_PASSWORD=choose-a-strong-secret

# Rate limiting (optional but recommended for the public chat endpoint).
# Provision via Vercel Marketplace → Upstash, which auto-injects these. If unset,
# the chat endpoint runs WITHOUT rate limiting (fail-open).
# UPSTASH_REDIS_REST_URL=https://YOUR-db.upstash.io
# UPSTASH_REDIS_REST_TOKEN=your-token
